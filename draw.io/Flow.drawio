        <mxCell id="Hn_WMQNJPxy1FPBOJ2gx-11" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" value="&lt;h2 style=&quot;white-space: normal;&quot;&gt;&lt;strong style=&quot;white-space: normal;&quot;&gt;&lt;font style=&quot;color: rgb(0, 127, 255);&quot;&gt;Lane 1 — Candidate&lt;/font&gt;&lt;/strong&gt;&lt;/h2&gt;&lt;ol start=&quot;1&quot; style=&quot;white-space: normal;&quot;&gt;&lt;li style=&quot;white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong style=&quot;white-space: pre-wrap;&quot;&gt;&lt;font style=&quot;color: rgb(0, 127, 255);&quot;&gt;Candidate registers&lt;/font&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong style=&quot;white-space: pre-wrap;&quot;&gt;&lt;font style=&quot;color: rgb(0, 127, 255);&quot;&gt;Uploads CV&lt;/font&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong style=&quot;white-space: pre-wrap;&quot;&gt;&lt;font style=&quot;color: rgb(0, 127, 255);&quot;&gt;Profile is interpreted → candidate reviews &amp;amp; edits&lt;/font&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong style=&quot;white-space: pre-wrap;&quot;&gt;&lt;font style=&quot;color: rgb(0, 127, 255);&quot;&gt;Candidate preferences set (salary, location, role, etc.)&lt;/font&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong style=&quot;white-space: pre-wrap;&quot;&gt;&lt;font style=&quot;color: rgb(0, 127, 255);&quot;&gt;Candidate waits for matches&lt;/font&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong style=&quot;white-space: pre-wrap;&quot;&gt;&lt;font style=&quot;color: rgb(0, 127, 255);&quot;&gt;Candidate receives match notifications (if score &amp;gt; threshold)&lt;/font&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong style=&quot;white-space: pre-wrap;&quot;&gt;&lt;font style=&quot;color: rgb(0, 127, 255);&quot;&gt;Candidate receives structured rejection reasons (if rejected)&lt;/font&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong style=&quot;white-space: pre-wrap;&quot;&gt;&lt;font style=&quot;color: rgb(0, 127, 255);&quot;&gt;Candidate can appeal or correct profile&lt;/font&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="278" width="402" x="-3227" y="-1067.5" as="geometry" />
        </mxCell>
        <mxCell id="Hn_WMQNJPxy1FPBOJ2gx-12" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#CC6600;" value="&lt;h2 style=&quot;white-space: normal;&quot;&gt;&lt;strong style=&quot;white-space: normal;&quot;&gt;Lane 2 — Recruiter / Company&lt;/strong&gt;&lt;/h2&gt;&lt;ol start=&quot;1&quot; style=&quot;white-space: normal;&quot;&gt;&lt;li style=&quot;white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong style=&quot;white-space: pre-wrap;&quot;&gt;Recruiter creates vacancy&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong style=&quot;white-space: pre-wrap;&quot;&gt;Job description interpreted → recruiter reviews &amp;amp; edits&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong style=&quot;white-space: pre-wrap;&quot;&gt;Job brief submitted to match engine&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong style=&quot;white-space: pre-wrap;&quot;&gt;Match engine scores all candidates&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong style=&quot;white-space: pre-wrap;&quot;&gt;Recruiter receives list of matched candidates&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong style=&quot;white-space: pre-wrap;&quot;&gt;Recruiter must tag each match: Interested / Rejected (with reason)&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong style=&quot;white-space: pre-wrap;&quot;&gt;Recruiter’s behaviour feeds fairness score&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&lt;strong style=&quot;white-space: pre-wrap;&quot;&gt;Company receives fairness metrics &amp;amp; compliance status&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
