{
  "name": "fhp-api",
  "version": "1.0.0",
  "description": "Fair Hiring Protocol — REST API",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:migrate": "psql $DATABASE_URL -f ../db/roles/000_roles.sql && for f in ../db/migrations/*.sql; do psql $DATABASE_URL -f \"$f\"; done",
    "db:seed": "for f in ../db/seeds/*.sql; do psql $DATABASE_URL -f \"$f\"; done",
    "seed:mock": "tsx scripts/seed-mock.ts",
    "seed:governance": "tsx scripts/seed-governance.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/jwt": "10.1.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.7.0",
    "@fastify/swagger-ui": "5.2.6",
    "fastify": "5.8.5",
    "postgres": "^3.4.9",
    "zod": "^3.24.3",
    "uuid": "^11.1.0",
    "bcrypt": "^5.1.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "fast-jwt": "6.2.4",
    "tar": "7.5.15"
  }
}