{
  "name": "fhp-api",
  "version": "1.0.0",
  "description": "Fair Hiring Protocol — REST API",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.0.0" },

  "scripts": {
    "dev":       "tsx watch src/server.ts",
    "build":     "tsc -p tsconfig.build.json",
    "start":     "node dist/server.js",
    "test":      "vitest run",
    "test:watch":"vitest",
    "typecheck": "tsc --noEmit",
    "lint":      "eslint src --ext .ts",
    "db:migrate":"psql $DATABASE_URL -f ../db/roles/000_roles.sql && for f in ../db/migrations/*.sql; do psql $DATABASE_URL -f \"$f\"; done",
    "db:seed":   "for f in ../db/seeds/*.sql; do psql $DATABASE_URL -f \"$f\"; done"
  },

  "dependencies": {
    "@fastify/cors":          "^9.0.1",
    "@fastify/helmet":        "^11.1.1",
    "@fastify/jwt":           "^8.0.1",
    "@fastify/rate-limit":    "^9.1.0",
    "@fastify/swagger":       "^8.15.0",
    "@fastify/swagger-ui":    "^4.0.1",
    "fastify":                "^4.28.1",
    "postgres":               "^3.4.4",
    "zod":                    "^3.23.8",
    "uuid":                   "^10.0.0",
    "bcrypt":                 "^5.1.1",
    "pino":                   "^9.3.2",
    "pino-pretty":            "^11.2.1",
    "dotenv":                 "^16.4.5"
  },

  "devDependencies": {
    "@types/bcrypt":          "^5.0.2",
    "@types/node":            "^20.14.0",
    "@types/uuid":            "^10.0.0",
    "tsx":                    "^4.16.2",
    "typescript":             "^5.5.3",
    "vitest":                 "^2.0.3"
  }
}
