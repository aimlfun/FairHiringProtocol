{
  "name": "fhp-api",
  "version": "1.0.0",
  "description": "Fair Hiring Protocol — REST API",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:migrate": "psql $DATABASE_URL -f ../db/roles/000_roles.sql && for f in ../db/migrations/*.sql; do psql $DATABASE_URL -f \"$f\"; done",
    "db:seed": "for f in ../db/seeds/*.sql; do psql $DATABASE_URL -f \"$f\"; done",
    "seed:mock": "tsx scripts/seed-mock.ts"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "@fastify/helmet": "11.1.1",
    "@fastify/jwt": "8.0.1",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/swagger": "8.15.0",
    "@fastify/swagger-ui": "4.2.0",
    "fastify": "4.29.1",
    "postgres": "^3.4.9",
    "zod": "^3.24.3",
    "uuid": "^11.1.0",
    "bcrypt": "^5.1.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}