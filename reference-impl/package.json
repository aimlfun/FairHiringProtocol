{
  "name": "fhp-reference-impl",
  "version": "1.0.0",
  "description": "Fair Hiring Protocol — canonical reference implementation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build":       "tsc --noEmit && tsc -p tsconfig.build.json",
    "dev":         "tsx watch src/api/server.ts",
    "test":        "vitest run",
    "test:watch":  "vitest",
    "test:conform": "vitest run tests/conformance",
    "lint":        "eslint . --ext .ts",
    "typecheck":   "tsc --noEmit",
    "fairness:job": "tsx src/fairness/job.ts",
    "sla:monitor":  "tsx src/sla/monitor.ts"
  },
  "dependencies": {
    "ajv":              "^8.17.1",
    "ajv-formats":      "^3.0.1",
    "better-sqlite3":   "^9.4.3",
    "express":          "^5.0.1",
    "pino":             "^9.3.2",
    "pino-pretty":      "^11.2.1",
    "uuid":             "^11.1.1",
    "zod":              "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express":        "^5.0.0",
    "@types/node":           "^20.14.0",
    "tsx":                   "^4.16.2",
    "typescript":            "^5.5.3",
    "vitest":                "^4.1.0"
  }
}
